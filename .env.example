# Copy to an ignored local env file. Never commit real values.
OPENAI_API_KEY=
ASKUTTY_TOKEN=

DRAGON_MODEL=gpt-5.6-terra
DRAGON_REASONING_EFFORT=medium
DRAGON_BIND_HOST=127.0.0.1
DRAGON_PORT=7798
DRAGON_CAPABILITY_MASK=7
DRAGON_MAX_INPUT_CHARS=8000
DRAGON_MAX_REQUESTS_PER_MINUTE=30
DRAGON_REQUEST_TIMEOUT_SECONDS=45
DRAGON_TELEMETRY_PATH=/run/universal-dragon/telemetry.json
DRAGON_TELEMETRY_MAX_AGE_SECONDS=30
DRAGON_SAFETY_IDENTIFIER=
DRAGON_TRUST_CLOUDFLARE_HEADERS=false

